{
  "name": "bamboo-monitor",
  "version": "1.0.0",
  "description": "Bamboo CI/CD deployment monitor with macOS notifications",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "dist:mac": "tsc && vite build && electron-builder --mac dmg",
    "preview": "vite preview",
    "icons": "bash scripts/generate-icons.sh"
  },
  "build": {
    "appId": "app.bamboo.monitor",
    "productName": "Bamboo Monitor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "lucide-react": "^1.16.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.7"
  }
}
